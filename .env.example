APP_NAME="TMCWD IT Request Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/tmcwd_itservice/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tmcwd_itservice
DB_USERNAME=root
DB_PASSWORD=

# ── Session ───────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120

# ── Queue (use sync for XAMPP — no worker needed) ─────────────────────
QUEUE_CONNECTION=sync

# ── Cache ─────────────────────────────────────────────────────────────
CACHE_STORE=file

# ── File Storage ──────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ── Mail ──────────────────────────────────────────────────────────────
# Development: Use Mailtrap (https://mailtrap.io → free account → Inboxes → SMTP Settings)
# Copy your inbox credentials into the values below.
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@tmcwd.gov.ph"
MAIL_FROM_NAME="${APP_NAME}"

# Production SMTP example:
# MAIL_MAILER=smtp
# MAIL_HOST=mail.tmcwd.gov.ph
# MAIL_PORT=587
# MAIL_USERNAME=noreply@tmcwd.gov.ph
# MAIL_PASSWORD=your_smtp_password
# MAIL_ENCRYPTION=tls
