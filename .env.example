APP_NAME="TMCWD IT Request Service"
# Set to 'production' on the office server. Use 'local' only on your development PC.
APP_ENV=production
APP_KEY=
# IMPORTANT: Set APP_DEBUG=false on the office server.
# Leaving it true leaks stack traces, file paths, and DB structure to any user who triggers an error.
APP_DEBUG=false
APP_URL=http://localhost/tmcwd_itservice/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

# ── Login rate limiting ────────────────────────────────────────────────
# Max failed login attempts per email+IP before lockout (per 60 seconds)
LOGIN_MAX_ATTEMPTS=5
# Max failed login attempts per IP across all accounts (per 120 seconds)
LOGIN_MAX_ATTEMPTS_IP=20

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tmcwd_itservice
DB_USERNAME=root
DB_PASSWORD=

# ── Session ───────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120

# ── Queue (use sync for XAMPP — no worker needed) ─────────────────────
QUEUE_CONNECTION=sync

# ── Cache ─────────────────────────────────────────────────────────────
CACHE_STORE=file

# ── File Storage ──────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ── Mail ──────────────────────────────────────────────────────────────
#
# CHOOSE ONE of the configurations below and fill in the credentials.
#
# ── Option A: Mailtrap (recommended for testing/development) ──────────
# Sign up free at https://mailtrap.io
# Go to: Email Testing → Inboxes → your inbox → SMTP Settings → Laravel
# Copy the credentials shown there into the fields below.
#
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=        ← paste your Mailtrap SMTP username here
MAIL_PASSWORD=        ← paste your Mailtrap SMTP password here
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@tmcwd.gov.ph"
MAIL_FROM_NAME="${APP_NAME}"
#
# ── Option B: Gmail (personal/org Gmail account) ──────────────────────
# Enable 2FA on the Gmail account, then generate an App Password:
# https://myaccount.google.com/apppasswords
#
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your.gmail@gmail.com
# MAIL_PASSWORD=your-16-char-app-password
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS="your.gmail@gmail.com"
# MAIL_FROM_NAME="${APP_NAME}"
#
# ── Option C: TMCWD office mail server (production) ──────────────────
# Ask your network/IT admin for the SMTP host, port, and credentials.
#
# MAIL_MAILER=smtp
# MAIL_HOST=mail.tmcwd.gov.ph       ← ask your IT admin
# MAIL_PORT=587                     ← typically 587 (TLS) or 465 (SSL)
# MAIL_USERNAME=noreply@tmcwd.gov.ph
# MAIL_PASSWORD=your_smtp_password
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS="noreply@tmcwd.gov.ph"
# MAIL_FROM_NAME="${APP_NAME}"
#
# ── Option D: No email (log only — safe fallback, email not sent) ─────
# MAIL_MAILER=log
#
# To test that email works after filling in credentials, run:
#   php artisan mail:test your@email.com
